# ===== 故事岔口 StoryFork 环境变量 =====
# 复制本文件为 .env.local 后填入真实值（.env.local 已被 .gitignore 忽略）

# 必填：你的 LLM API Key（例如 DeepSeek 开放平台 platform.deepseek.com 中创建）
LLM_API_KEY=

# 可选：OpenAI Chat Completions 兼容的接口地址，默认 DeepSeek
LLM_BASE_URL=https://api.deepseek.com

# 可选：模型名，默认 deepseek-chat
LLM_MODEL=deepseek-chat

# 可选：访问口令（留空则不启用）。配置后首页要求输入口令，
# 前端通过请求头 x-access-code 上送，服务端校验不符返回 403。
ACCESS_CODE=
